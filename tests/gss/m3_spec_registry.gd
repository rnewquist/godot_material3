static func get_entries() -> Array[Dictionary]:
	return ENTRIES

static func get_entry(spec_id: String) -> Dictionary:
	for e in ENTRIES:
		if str(e["id"]) == spec_id:
			return e
	return {}

static func has_id(spec_id: String) -> bool:
	return not get_entry(spec_id).is_empty()

static func get_categories() -> Array[String]:
	var cats: Array[String] = []
	for e in ENTRIES:
		var c: String = str(e["category"])
		if not cats.has(c):
			cats.append(c)
	return cats
